package Cam where

import Vector

-- 按内容并行比对的表：一拍之内所有项一起比。单端口 SRAM 一拍只读得出一项，
-- 比不了，所以 D38 的「超过约 900 位就上 SRAM 宏」对它不成立——只能触发器
-- 加比较器。eswitch 的 MAC 学习表、将来的 TLB、cache 的标签阵列都是这个
-- 形状，共用这一份。
--
-- 写成 BH（Bluespec 的 Haskell 语法）而不是 BSV：这里没有一拍一拍的协议，
-- 全是对一张表的函数式操作——命中是 findIndex，落位是几个候选依次兜底。
-- 用方程写比用可变结构体挨个赋值短一半，分支也漏不掉。

struct Slot k v =
    key   :: k
    val   :: v
    valid :: Bool
  deriving (Bits, FShow)

interface (Cam :: # -> * -> * -> *) n k v =
    lookup  :: k -> Maybe v
    learn   :: k -> v -> Action
    evict   :: k -> Action
    flush   :: Action
    dump    :: Vector n (Slot k v)
    -- 这个键此刻学进去会落在哪一槽。与 learn 读同一份状态，调用方同一拍据此
    -- 给槽配旁挂的数据（eswitch 的老化时间戳）
    place   :: k -> UInt (TLog n)
    -- 按槽清掉。老化按槽扫，已经知道是哪一格，不必再按键比一遍
    clearAt :: UInt (TLog n) -> Action

-- 模块单子留成多态的。写死 Module 的话，例化它的模块也会被推成 Module，
-- 而 BSV 那边的模块默认对 IsModule 多态，两边对不上（T0029）。
mkCam :: (IsModule m c, Bits k kw, Eq k, Bits v vw) => m (Cam n k v)
mkCam =
  module
    let empty :: Slot k v
        empty = Slot { key = unpack 0; val = unpack 0; valid = False }

    tab :: Vector n (Reg (Slot k v)) <- replicateM (mkReg empty)
    -- 满了轮换覆盖
    turn :: Reg (UInt (TLog n)) <- mkReg 0

    let slots = map readReg tab
        holds k s = s.valid && s.key == k
        isFree s = not s.valid
        -- 落位只有一种算法，learn 与 place 共用，免得两处漂开：
        -- 已经在表里就原地更新，端设备换口时才认得出来；否则先填空位；
        -- 都满了才轮换覆盖。第二项说这一次是不是占了轮换的那一格
        slotOf k =
          case findIndex (holds k) slots of
            Just x -> (x, False)
            Nothing -> case findIndex isFree slots of
                         Just x -> (x, False)
                         Nothing -> (turn, True)

    interface
      lookup k =
        case find (holds k) slots of
          Just s -> Just s.val
          Nothing -> Nothing

      learn k v =
        case slotOf k of
          (i, rotate) -> do
            (select tab i) := Slot { key = k; val = v; valid = True }
            if rotate
              then turn := if turn == fromInteger (valueOf n - 1)
                             then 0 else turn + 1
              else noAction

      evict k =
        case findIndex (holds k) slots of
          Just i -> (select tab i) := empty
          Nothing -> noAction

      flush = do
        writeVReg tab (replicate empty)
        turn := 0

      dump = slots

      place k =
        case slotOf k of
          (i, _) -> i

      clearAt i = (select tab i) := empty
